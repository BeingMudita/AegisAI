# AegisAI dashboard — build with Node, serve static files with nginx.
#   docker build -f docker/Dockerfile.frontend .
FROM node:25-alpine AS build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
# Empty → the app calls /api on its own origin, which nginx proxies.
ARG VITE_API_URL=""
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build

# Unprivileged nginx: runs as uid 101 and listens on 8080, so the container never
# runs as root (Trivy DS-0002).
FROM nginxinc/nginx-unprivileged:1.30-alpine
# Patch base-image OS packages that have a fix available (e.g. CVE-2026-4775,
# libtiff). Trivy fails the build on any fixable HIGH/CRITICAL.
USER root
RUN apk upgrade --no-cache tiff
USER 101
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
USER 101
EXPOSE 8080
