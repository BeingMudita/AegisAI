# Leave empty in development — Vite proxies /api to http://localhost:8000.
# For a separately hosted API (e.g. Vercel → Render), set its origin and add
# the dashboard's URL to the backend's CORS_ORIGINS.
VITE_API_URL=

# Optional development proxy target, for example when port 8000 is occupied.
AEGIS_API_TARGET=http://localhost:8000
