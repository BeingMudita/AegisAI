# ===========================================================================
# AegisAI — Environment Variables (EXAMPLE)
# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` — it is git-ignored.
# ===========================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=AegisAI
ENVIRONMENT=development      # development | staging | production
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO              # DEBUG | INFO | WARNING | ERROR

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Database (PostgreSQL + pgvector)
# ---------------------------------------------------------------------------
POSTGRES_USER=aegis
POSTGRES_PASSWORD=change_me_in_local_env
POSTGRES_DB=aegisai
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Full SQLAlchemy async URL (derived from the parts above if omitted)
DATABASE_URL=postgresql+asyncpg://aegis:change_me_in_local_env@localhost:5432/aegisai

# ---------------------------------------------------------------------------
# Security / Auth
# ---------------------------------------------------------------------------
# In production use 32+ random characters, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=generate_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Seed accounts (admin / analyst / agent). The defaults are dev-only:
# with ENVIRONMENT=production the API refuses to start until these and
# JWT_SECRET are changed.
SEED_ADMIN_PASSWORD=admin123
SEED_ANALYST_PASSWORD=analyst123
SEED_AGENT_PASSWORD=agent123

# ---------------------------------------------------------------------------
# AI / LLM (Ollama — local inference)
# ---------------------------------------------------------------------------
# auto = use Ollama when it is running and MODEL_NAME is pulled, otherwise the
# deterministic rule-based planner. Options: auto | ollama | rule_based
LLM_BACKEND=auto
MODEL_NAME=llama3.1:8b       # smaller alternative: qwen2.5:1.5b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=120
AGENT_MAX_STEPS=3            # max tool calls per agent turn

# Embeddings. auto = sentence-transformers if installed
# (pip install -r backend/requirements-ml.txt), else the hashing embedder.
EMBEDDING_BACKEND=auto       # auto | sentence_transformers | hashing
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ---------------------------------------------------------------------------
# RAG
# ---------------------------------------------------------------------------
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_TOP_K=5
RAG_SEED_CORPUS=true         # ingest the demo corpus in backend/app/rag/seed/

# ---------------------------------------------------------------------------
# Trust / Firewall / Policies
# ---------------------------------------------------------------------------
TRUST_THRESHOLD=0.6          # default trust needed for tools without min_trust
FIREWALL_FLAG_THRESHOLD=0.4  # score at/above which content is flagged + sanitized
FIREWALL_BLOCK_THRESHOLD=0.8 # score at/above which content is blocked
POLICY_CONFIG_PATH=app/policies/default_policies.yaml

# ---------------------------------------------------------------------------
# Telemetry
# ---------------------------------------------------------------------------
AUDIT_BUFFER_SIZE=5000       # security events kept in memory
